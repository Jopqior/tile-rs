// Throwaway standalone IR, not generated by tile-rs.
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=256, v_row=1, v_col=256, blayout=row_major, slayout=none_box, fractal=512, pad=0>
!view = !pto.tensor_view<?x?xf32>
!part = !pto.partition_tensor_view<1x256xf32>
module {
  func.func @add_generated(%a: !pto.ptr<f32>, %b: !pto.ptr<f32>, %out: !pto.ptr<f32>) {
    %zero = arith.constant 0 : index
    %one = arith.constant 1 : index
    %n = arith.constant 256 : index
    %av = pto.make_tensor_view %a, shape = [%one, %n], strides = [%n, %one] : !view
    %bv = pto.make_tensor_view %b, shape = [%one, %n], strides = [%n, %one] : !view
    %ov = pto.make_tensor_view %out, shape = [%one, %n], strides = [%n, %one] : !view
    %ap = pto.partition_view %av, offsets = [%zero, %zero], sizes = [%one, %n] : !view -> !part
    %bp = pto.partition_view %bv, offsets = [%zero, %zero], sizes = [%one, %n] : !view -> !part
    %op = pto.partition_view %ov, offsets = [%zero, %zero], sizes = [%one, %n] : !view -> !part
    %x = pto.alloc_tile : !tile
    %y = pto.alloc_tile : !tile
    %z = pto.alloc_tile : !tile
    pto.tload ins(%ap : !part) outs(%x : !tile)
    pto.tload ins(%bp : !part) outs(%y : !tile)
    pto.tadd ins(%x, %y : !tile, !tile) outs(%z : !tile)
    pto.tstore ins(%z : !tile) outs(%op : !part)
    return
  }
}
